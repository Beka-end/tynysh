# Скопируй этот файл в .env.local и подставь свои значения.
# .env.local НИКОГДА не попадает в git (он в .gitignore).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Ключ Claude для Доса (этап 3). Только на сервере, без NEXT_PUBLIC_!
# Взять на console.anthropic.com → API keys. В браузер он не попадает.
ANTHROPIC_API_KEY=sk-ant-...
